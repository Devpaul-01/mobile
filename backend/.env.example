# Copy to .env and fill in real values. Never commit .env.
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/bm_mobile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=bm_mobile

REDIS_URL=redis://redis:6379/0

# EXPO_PUBLIC_API_URL in the mobile app must point here for local dev.
CORS_ORIGINS=["http://localhost:8081","exp://127.0.0.1:19000"]

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# SMTP (verification/reset/reminder emails) — optional; leave unset for
# local dev, the app logs instead of sending. See app/services/smtp.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=BirthdayMessaging

# Not yet used by Milestone 1 (auth-only) — populated in later phases:
# S3_*, PAYPAL_*
